page {
  min-height: 100vh;
  color: #171512;
  background: #f6f0e7;
  font-family: "Times New Roman", "Songti SC", serif;
}

button {
  box-sizing: border-box;
  border-radius: 8px;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  background: #f6f0e7;
}

.serif-title {
  font-size: 66rpx;
  line-height: 1.08;
  font-weight: 800;
  letter-spacing: 0;
}

.label {
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.muted {
  color: #5c554d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-button {
  color: #fff;
  background: #171512;
}

.secondary-button {
  color: #171512;
  border: 1rpx solid rgba(23,21,18,.14);
  background: rgba(255,255,255,.56);
}

.primary-button[disabled] {
  opacity: .34;
}

.panel {
  box-sizing: border-box;
  padding: 32rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.54);
}

.search {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 90rpx;
  margin-bottom: 28rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.66);
}

.search input {
  flex: 1;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}

.section-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-row .title {
  font-size: 44rpx;
  font-weight: 800;
}

.bottom-action {
  margin-top: 28rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 18rpx;
  background: rgba(246,240,231,.88);
}

.loading {
  padding: 24rpx;
  color: #827b70;
  border: 1rpx dashed rgba(23,21,18,.22);
  border-radius: 12rpx;
  background: rgba(255,255,255,.52);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 26rpx;
  font-weight: 700;
}

.avatar-placeholder {
  display: block;
  max-width: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.1;
  text-align: center;
  white-space: nowrap;
}
