page {
  min-height: 100vh;
  color: #171512;
  background: #f6f0e7;
  font-family: "Times New Roman", "Songti SC", serif;
}

button {
  box-sizing: border-box;
  border-radius: 8px;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  background: #f6f0e7;
}

.serif-title {
  font-size: 66rpx;
  line-height: 1.08;
  font-weight: 800;
  letter-spacing: 0;
}

.label {
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.muted {
  color: #5c554d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-button {
  color: #fff;
  background: #171512;
}

.secondary-button {
  color: #171512;
  border: 1rpx solid rgba(23,21,18,.14);
  background: rgba(255,255,255,.56);
}

.primary-button[disabled] {
  opacity: .34;
}

.panel {
  box-sizing: border-box;
  padding: 32rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.54);
}

.search {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 90rpx;
  margin-bottom: 28rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.66);
}

.search input {
  flex: 1;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}

.section-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-row .title {
  font-size: 44rpx;
  font-weight: 800;
}

.bottom-action {
  margin-top: 28rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 18rpx;
  background: rgba(246,240,231,.88);
}

.loading {
  padding: 24rpx;
  color: #827b70;
  border: 1rpx dashed rgba(23,21,18,.22);
  border-radius: 12rpx;
  background: rgba(255,255,255,.52);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 26rpx;
  font-weight: 700;
}

.avatar-placeholder {
  display: block;
  max-width: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.1;
  text-align: center;
  white-space: nowrap;
}

.creator-profile-modal-mask {
  position: fixed;
  z-index: 999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(23,21,18,.34);
}

.creator-profile-modal {
  width: 100%;
  max-width: 640rpx;
  padding: 42rpx 36rpx 36rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 16rpx;
  background: #fffdfa;
  text-align: center;
}

.creator-profile-modal-title {
  color: #171512;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 900;
}

.creator-profile-modal-copy {
  margin-top: 14rpx;
  color: #5c554d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 26rpx;
  line-height: 1.6;
}

.creator-profile-modal .creator-modal-avatar,
.creator-profile-modal button.creator-modal-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 132rpx;
  width: 132rpx !important;
  height: 132rpx !important;
  min-width: 132rpx !important;
  min-height: 132rpx !important;
  max-width: 132rpx !important;
  max-height: 132rpx !important;
  margin: 30rpx auto 24rpx !important;
  padding: 0 !important;
  box-sizing: border-box;
  overflow: hidden !important;
  border: 0;
  border-radius: 50% !important;
  background: #171512;
  color: #fffdfa;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.creator-profile-modal .creator-modal-avatar::after {
  border: 0;
}

.creator-profile-modal .creator-modal-avatar image {
  display: block;
  width: 132rpx;
  height: 132rpx;
  min-width: 132rpx;
  min-height: 132rpx;
  max-width: 132rpx;
  max-height: 132rpx;
  border-radius: 50%;
}

.creator-profile-modal .creator-modal-avatar text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
}

.creator-modal-input {
  width: 100%;
  height: 88rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.14);
  border-radius: 10rpx;
  background: rgba(246,240,231,.72);
  color: #171512;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  text-align: left;
}

.creator-modal-confirm {
  width: 100%;
}
