.summary {
  margin-bottom: 28rpx;
}

.shared-result-state {
  min-height: 760rpx;
  padding-top: 120rpx;
  box-sizing: border-box;
}

.shared-result-state view {
  margin: 18rpx 0;
  color: #171512;
  font-size: 58rpx;
  line-height: 1.12;
  font-weight: 900;
}

.shared-result-state text:last-child {
  display: block;
  max-width: 560rpx;
  color: #6f6961;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 700;
}

.shared-result-enter {
  width: 360rpx;
  margin: 56rpx auto 0;
}

.score {
  margin: 8rpx 0 12rpx;
  font-size: 76rpx;
  line-height: 1;
  font-weight: 800;
}

.pair-summary {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 18rpx 0 8rpx;
  min-width: 0;
}

.pair-head {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}

.pair-head-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  box-sizing: border-box;
  overflow: hidden;
  color: #fffdfa;
  background: #171512;
  font-size: 22rpx;
  font-weight: 900;
}

.pair-head-avatar.friend {
  background: #3d7f5a;
}

.pair-head-avatar image {
  width: 100%;
  height: 100%;
}

.pair-head-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 10rpx;
  color: #171512;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.pair-summary > view:last-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 900;
}

.album-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -8rpx;
}

.tile {
  width: 31.8%;
  margin-right: 8rpx;
  margin-bottom: 18rpx;
  color: #171512;
  background: transparent;
}

.cover-box {
  position: relative;
  width: 100%;
  height: 214rpx;
  overflow: hidden;
  background: #171512;
}

.cover-box image {
  width: 100%;
  height: 100%;
  opacity: .82;
}

.tile-copy {
  min-height: 74rpx;
  padding-top: 8rpx;
}

.tile-copy view {
  font-size: 26rpx;
  line-height: 1.15;
  font-weight: 800;
}

.tile-copy text {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 20rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #5f584f;
  word-break: break-all;
}

.badge {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  padding: 8rpx 12rpx;
  background: #3d7f5a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 20rpx;
  font-weight: 800;
}

.badge.no {
  background: rgba(106,103,100,.86);
}

.result-lists {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 28rpx 0;
}

.result-list {
  min-height: 220rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.52);
}

.result-list.ok {
  background: rgba(227,239,230,.76);
}

.result-list view {
  margin-bottom: 16rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.result-list text,
.result-list label {
  display: block;
}

.result-list text {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.result-list label {
  color: #5f584f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
  line-height: 1.35;
}

.bottom-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 28rpx;
}

.bottom-actions.single-action {
  grid-template-columns: 1fr;
}

.bottom-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.color-result-title {
  margin: 12rpx 0 24rpx;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 900;
}

.color-result-grid {
  display: grid;
  gap: 20rpx;
}

.color-result-card {
  padding: 22rpx;
  border: 1rpx solid rgba(23,21,18,.12);
  border-radius: 4rpx;
  box-shadow: 0 10rpx 22rpx rgba(23,21,18,.06);
}

.color-result-card.matched {
  box-shadow: 0 10rpx 22rpx rgba(23,21,18,.06);
}

.color-result-name {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.color-pair-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.color-pick {
  min-width: 0;
}

.color-pick-person {
  display: grid;
  grid-template-columns: 34rpx minmax(0, 1fr);
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  min-width: 0;
}

.color-pick-person image,
.color-pick-person view {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #171512;
}

.color-pick-person view {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdfa;
  font-size: 17rpx;
  font-weight: 900;
}

.color-pick-person text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 900;
}

.color-pick-cover {
  position: relative;
  width: 100%;
  height: auto;
  padding-bottom: 100%;
  overflow: hidden;
  border-radius: 2rpx;
  background: #fffdfa;
}

.color-pick-cover image,
.color-cover-placeholder {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 2rpx;
}

.color-song-copy {
  margin-top: 10rpx;
  min-width: 0;
}

.color-song-copy text,
.color-song-copy label {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.color-song-copy text {
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 900;
}

.color-song-copy label {
  margin-top: 4rpx;
  font-size: 21rpx;
  font-weight: 700;
  opacity: .8;
}

.color-result-canvas {
  position: fixed;
  left: -2600px;
  top: -2600px;
  width: 750px;
  height: 4200px;
}

.result-timeline-canvas {
  position: fixed;
  left: -2600px;
  top: -2600px;
  width: 1000px;
  height: 1000px;
}

.qa-result-head {
  margin: 12rpx 0 26rpx;
}

.qa-result-title {
  margin: 8rpx 0 18rpx;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 900;
}

.qa-profile-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.qa-profile {
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr);
  align-items: center;
  gap: 10rpx;
  flex: 0 1 46%;
  min-width: 0;
  max-width: 46%;
}

.qa-profile image,
.qa-profile view {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #171512;
}

.qa-profile view {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdfa;
  font-size: 20rpx;
  font-weight: 900;
}

.qa-profile text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 900;
}

.qa-result-list {
  display: grid;
  gap: 18rpx;
}

.qa-result-card {
  padding: 20rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 8rpx;
  background: rgba(255,255,255,.52);
}

.qa-result-prompt {
  margin-bottom: 18rpx;
}

.qa-result-prompt text {
  display: block;
}

.qa-result-prompt text {
  font-size: 31rpx;
  line-height: 1.2;
  font-weight: 900;
}

.qa-answer-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.qa-answer {
  min-width: 0;
}

.qa-answer-person {
  margin-bottom: 8rpx;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qa-answer-cover {
  position: relative;
  width: 100%;
  height: auto;
  padding-bottom: 100%;
  overflow: hidden;
  border-radius: 4rpx;
  background: #f4b536;
}

.qa-answer-cover image,
.qa-answer-cover view {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
}

.qa-answer-cover view {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #171512;
  border: 2rpx solid #171512;
  box-sizing: border-box;
  font-size: 58rpx;
  font-weight: 900;
}

.qa-song-copy {
  margin-top: 10rpx;
  min-width: 0;
}

.qa-song-copy text,
.qa-song-copy label {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qa-song-copy text {
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 900;
}

.qa-song-copy label {
  margin-top: 4rpx;
  font-size: 21rpx;
  font-weight: 700;
  opacity: .78;
}

.qa-bottom-actions {
  grid-template-columns: 1fr;
}

.top9-result-page {
  padding-bottom: 20rpx;
}

.top9-summary {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 172rpx;
  gap: 22rpx;
  align-items: start;
  padding: 22rpx 0 8rpx;
}

.top9-summary-copy {
  min-width: 0;
}

.top9-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.top9-title-row .label {
  flex: 0 0 auto;
  color: #171512;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 0;
  text-transform: none;
}

.top9-pair-summary {
  flex: 1 1 auto;
  gap: 10rpx;
  min-width: 0;
  margin: 0;
}

.top9-pair-summary .pair-head-avatar {
  width: 40rpx;
  height: 40rpx;
  font-size: 18rpx;
}

.top9-pair-summary .pair-head-mark {
  margin: 0 6rpx;
  font-size: 16rpx;
}

.top9-pair-summary > view:last-child {
  font-size: 24rpx;
}

.top9-artist {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.top9-result-copy {
  display: block;
  margin-top: 8rpx;
  line-height: 1.35;
}

.top9-artist-cover {
  width: 172rpx;
  height: 172rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  background: rgba(23,21,18,.08);
}

.top9-artist-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #171512;
  font-size: 56rpx;
  font-weight: 900;
}

.top9-section {
  margin: 22rpx 0;
  padding: 20rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.52);
}

.top9-section.shared {
  background: rgba(227,239,230,.72);
}

.top9-section-title,
.top9-column-title {
  margin-bottom: 22rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.top9-empty-result {
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  line-height: 1.4;
}

.shared-song-row {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: center;
  min-height: 88rpx;
  padding: 8rpx 0;
}

.shared-song-row image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 6rpx;
  background: rgba(23,21,18,.08);
}

.shared-song-row text {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shared-song-row label {
  display: block;
  margin-top: 6rpx;
  color: #3d7f5a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
  font-weight: 800;
}

.shared-song-row .rank-hit-inline {
  color: #6b6258;
  font-size: 20rpx;
  line-height: 1.35;
  font-weight: 700;
}

.top9-compare {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

.top9-column {
  min-width: 0;
  padding: 16rpx 12rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.52);
}

.top9-column-title {
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top9-result-row {
  display: grid;
  grid-template-columns: 36rpx 54rpx minmax(0, 1fr);
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
  margin-bottom: 8rpx;
  padding: 6rpx;
  border-radius: 8rpx;
}

.top9-result-row.matched {
  background: rgba(61,127,90,.12);
}

.top9-result-row text {
  color: #3d7f5a;
  font-size: 20rpx;
  font-weight: 900;
}

.top9-result-row image {
  width: 54rpx;
  height: 54rpx;
  border-radius: 6rpx;
  background: rgba(23,21,18,.08);
}

.top9-result-row view {
  min-width: 0;
  font-size: 22rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
