@import "../../styles/song-row.wxss";

button::after {
  border: 0;
}

.intro-page {
  width: 100%;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.intro-page .panel,
.setup-stage,
.waiting-stage,
.game-stage,
.finished-stage {
  min-width: 0;
  max-width: 100%;
}

.intro-heading {
  margin: 8rpx 0 24rpx;
}

.heading-row,
.round-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.intro-heading .serif-title {
  margin: 12rpx 0 10rpx;
  font-size: 54rpx;
}

.live-pill {
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #5c554d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 20rpx;
  font-weight: 800;
}

.live-pill text {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d43a31;
  box-shadow: 0 0 0 6rpx rgba(212, 58, 49, .1);
}

.state-panel {
  display: flex;
  min-height: 480rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  text-align: center;
}

.loading-record {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at center, #f6f0e7 0 10rpx, #171512 11rpx 20rpx, transparent 21rpx),
    repeating-radial-gradient(circle at center, #171512 0 4rpx, #2a2825 5rpx 7rpx);
  box-shadow: inset 0 0 0 8rpx #171512, 0 10rpx 24rpx rgba(23, 21, 18, .14);
  animation: record-spin 1.8s linear infinite;
}

@keyframes record-spin {
  to { transform: rotate(360deg); }
}

.state-title {
  max-width: 560rpx;
  margin: 28rpx 0 12rpx;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.profile-card {
  margin-top: 24rpx;
  text-align: center;
}

.section-title {
  margin: 12rpx 0 10rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
}

.profile-avatar {
  display: flex;
  width: 152rpx;
  height: 152rpx;
  align-items: center;
  justify-content: center;
  margin: 38rpx auto 24rpx;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: 50%;
  color: #fffdfa;
  background: #171512;
  font-size: 22rpx;
  font-weight: 800;
}

.profile-avatar image {
  width: 100%;
  height: 100%;
}

.profile-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23, 21, 18, .14);
  border-radius: 10rpx;
  background: rgba(246, 240, 231, .72);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  text-align: center;
}

.profile-confirm {
  width: 100%;
  margin-top: 24rpx;
}

.setup-stage,
.waiting-stage,
.game-stage,
.finished-stage {
  display: grid;
  gap: 20rpx;
}

.setup-panel {
  padding: 24rpx;
}

.compact-section-row {
  min-height: 58rpx;
  align-items: center;
  margin-bottom: 18rpx;
}

.compact-section-row .title {
  font-size: 34rpx;
}

.mode-options {
  display: flex;
  width: 100%;
  gap: 14rpx;
  box-sizing: border-box;
}

.mode-option {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  min-height: 112rpx;
  flex-direction: column;
  margin: 0;
  padding: 16rpx 12rpx;
  line-height: 1.2;
}

.mode-option text,
.mode-option label {
  display: block;
}

.mode-option text {
  font-size: 28rpx;
}

.mode-option label {
  margin-top: 7rpx;
  color: #827b70;
  font-size: 19rpx;
  font-weight: 700;
}

.mode-option.selected,
.duration-option.selected,
.question-count-option.selected {
  color: #fffdfa;
  border-color: #171512;
  background: #171512;
}

.mode-option.selected label {
  color: rgba(255, 253, 250, .72);
}

.compact-button {
  width: 112rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0;
  font-size: 22rpx;
}

.artist-summary {
  display: grid;
  grid-template-columns: 104rpx minmax(0, 1fr);
  align-items: center;
  gap: 20rpx;
}

.artist-summary .artist-cover {
  width: 104rpx;
  height: 104rpx;
}

.artist-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdfa;
  background: #171512;
  font-size: 36rpx;
  font-weight: 900;
}

.duration-panel {
  overflow: hidden;
}

.section-hint {
  display: block;
  margin-top: 4rpx;
  color: #827b70;
  font-size: 21rpx;
  font-weight: 700;
}

.duration-options {
  display: flex;
  width: 100%;
  gap: 10rpx;
  box-sizing: border-box;
}

.duration-option {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  min-height: 82rpx;
  margin: 0;
  padding: 0;
  font-size: 30rpx;
}

.duration-option text {
  margin-left: 3rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.question-count-options {
  display: flex;
  width: 100%;
  gap: 10rpx;
  box-sizing: border-box;
}

.question-count-option,
.custom-count-option {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 82rpx;
  margin: 0;
  box-sizing: border-box;
}

.question-count-option {
  min-height: 82rpx;
  padding: 0;
  font-size: 30rpx;
}

.question-count-option text,
.custom-count-option > text {
  margin-left: 3rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.question-count-option[disabled] {
  opacity: .28;
}

.custom-count-option {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid rgba(23, 21, 18, .14);
  border-radius: 8px;
  color: #171512;
  background: rgba(255, 255, 255, .56);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-weight: 800;
}

.custom-count-option.selected {
  color: #fffdfa;
  border-color: #171512;
  background: #171512;
}

.custom-count-option input {
  width: 64%;
  min-width: 0;
  height: 82rpx;
  color: inherit;
  font-size: 27rpx;
  font-weight: 800;
  text-align: right;
}

.custom-count-option input::placeholder {
  color: #827b70;
}

.section-hint.warning {
  color: #a72c22;
}

.rule-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 0;
  overflow: hidden;
}

.rule-chip {
  display: flex;
  min-height: 104rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid rgba(23, 21, 18, .1);
}

.rule-chip:last-child {
  border-right: 0;
}

.rule-chip text {
  font-size: 34rpx;
  font-weight: 900;
}

.rule-chip label {
  margin-top: 4rpx;
  color: #827b70;
  font-size: 20rpx;
  font-weight: 700;
}

.setup-note {
  padding: 0 8rpx;
}

.inline-error {
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  color: #a72c22;
  background: rgba(212, 58, 49, .08);
  font-size: 24rpx;
  line-height: 1.5;
}

.intro-actions,
.waiting-actions,
.finished-actions {
  margin: 0;
  padding: 16rpx;
}

.intro-actions button,
.waiting-actions button,
.finished-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
}

.waiting-heading {
  text-align: left;
}

.player-list {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.player-row {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(23, 21, 18, .08);
}

.player-row:last-child {
  border-bottom: 0;
}

.player-row image,
.player-avatar-text {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fffdfa;
  background: #171512;
  font-size: 26rpx;
  font-weight: 800;
}

.player-copy text,
.player-copy label {
  display: block;
}

.player-copy text {
  font-size: 28rpx;
  font-weight: 800;
}

.player-copy label {
  margin-top: 5rpx;
  color: #827b70;
  font-size: 21rpx;
  font-weight: 700;
}

.player-row.empty {
  opacity: .48;
}

.ready-mark {
  color: #3d7f5a;
  font-size: 28rpx;
  font-weight: 900;
}

.waiting-actions,
.finished-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
}

.waiting-actions .host-waiting {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  text-align: center;
}

.scoreboard {
  width: 100%;
  padding: 14rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.scoreboard-track {
  display: inline-flex;
  min-width: 100%;
  gap: 10rpx;
}

.score-player {
  position: relative;
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr);
  align-items: center;
  gap: 10rpx;
  flex: 0 0 218rpx;
  width: 218rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23, 21, 18, .12);
  border-radius: 10rpx;
  background: rgba(255, 255, 255, .5);
}

.score-player.me {
  color: #fffdfa;
  background: #171512;
}

.score-avatar {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  color: #171512;
  background: #e8dfd3;
  font-weight: 900;
}

.score-avatar image {
  width: 100%;
  height: 100%;
}

.score-copy {
  min-width: 0;
}

.score-copy text,
.score-copy label {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-copy text {
  font-size: 22rpx;
  font-weight: 800;
}

.score-copy label {
  margin-top: 3rpx;
  opacity: .7;
  font-size: 19rpx;
}

.answered-dot {
  position: absolute;
  top: -8rpx;
  right: -6rpx;
  display: flex;
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #3d7f5a;
  font-size: 16rpx;
}

.listen-panel {
  padding: 24rpx;
}

.round-line label {
  color: #827b70;
  font-size: 22rpx;
  font-weight: 700;
  text-align: right;
}

.listen-disc {
  position: relative;
  width: 250rpx;
  height: 250rpx;
  margin: 30rpx auto 24rpx;
  border-radius: 50%;
  background: #171512;
  box-shadow: 0 16rpx 34rpx rgba(23, 21, 18, .17);
}

.listen-disc.spinning {
  animation: disc-spin 3s linear infinite;
}

@keyframes disc-spin {
  to { transform: rotate(360deg); }
}

.disc-groove {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, .18);
  border-radius: 50%;
}

.disc-groove.outer { inset: 30rpx; }
.disc-groove.inner { inset: 54rpx; }

.disc-center {
  position: absolute;
  inset: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fffdfa;
  background: #d43a31;
}

.disc-center text {
  font-size: 34rpx;
  font-weight: 900;
}

.disc-center label {
  font-size: 16rpx;
  font-weight: 700;
}

.time-track {
  height: 7rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(23, 21, 18, .12);
}

.time-track view {
  height: 100%;
  border-radius: 999rpx;
  background: #d43a31;
  transition: width .18s linear;
}

.answer-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  box-sizing: border-box;
}

.answer-option {
  display: grid;
  grid-template-columns: 36rpx minmax(0, 1fr) 32rpx;
  flex: 0 0 calc(50% - 6rpx);
  width: calc(50% - 6rpx);
  min-width: 0;
  min-height: 104rpx;
  align-items: center;
  gap: 10rpx;
  margin: 0 0 12rpx;
  padding: 14rpx 16rpx;
  color: #171512;
  line-height: 1.25;
  text-align: left;
}

.answer-option:nth-child(odd) {
  margin-right: 6rpx;
}

.answer-option:nth-child(even) {
  margin-left: 6rpx;
}

.answer-option:nth-last-child(-n+2) {
  margin-bottom: 0;
}

.option-letter {
  font-size: 22rpx;
  font-weight: 900;
}

.answer-option > view {
  min-width: 0;
  overflow: hidden;
  font-size: 23rpx;
  text-overflow: ellipsis;
}

.option-result-mark {
  justify-self: end;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}

.answer-option[disabled] {
  opacity: 1;
  color: #171512;
}

.answer-grid.locked .answer-option {
  opacity: .48;
}

.answer-option.selected {
  color: #fffdfa;
  border-color: #171512;
  background: #171512;
}

.answer-option.correct {
  color: #fff;
  border-color: #3d7f5a;
  background: #3d7f5a;
}

.answer-option.wrong {
  color: #fff;
  border-color: #d43a31;
  background: #d43a31;
}

.result-summary {
  text-align: center;
}

.accuracy-number {
  margin-top: 28rpx;
  font-size: 116rpx;
  font-weight: 900;
  line-height: 1;
}

.accuracy-number text {
  margin-left: 5rpx;
  color: #d43a31;
  font-size: 38rpx;
}

.accuracy-label {
  display: block;
  margin-top: 8rpx;
  color: #827b70;
  font-size: 22rpx;
  font-weight: 700;
}

.final-ranking {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.ranking-row {
  display: grid;
  grid-template-columns: 38rpx 62rpx minmax(0, 1fr) auto;
  min-height: 90rpx;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid rgba(23, 21, 18, .08);
}

.ranking-row:last-child {
  border-bottom: 0;
}

.ranking-row > text,
.ranking-score {
  font-size: 22rpx;
  font-weight: 900;
}

.ranking-avatar {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  color: #fffdfa;
  background: #171512;
  font-weight: 800;
}

.ranking-avatar image {
  width: 100%;
  height: 100%;
}

.ranking-name {
  min-width: 0;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.error-state .primary-button,
.error-state .secondary-button {
  width: 100%;
  margin-top: 14rpx;
}

.error-label {
  color: #a72c22;
}

@media (max-width: 360px) {
  .intro-heading .serif-title {
    font-size: 48rpx;
  }

  .mode-option label {
    font-size: 17rpx;
  }

  .duration-options {
    gap: 6rpx;
  }

  .duration-option,
  .question-count-option {
    font-size: 26rpx;
  }

  .question-count-options {
    gap: 6rpx;
  }

  .custom-count-option input {
    font-size: 23rpx;
  }

  .answer-option {
    grid-template-columns: 28rpx minmax(0, 1fr);
    padding: 12rpx 10rpx;
  }
}
