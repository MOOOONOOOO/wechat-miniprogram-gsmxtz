.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.progress {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  margin-bottom: 28rpx;
}

.progress > view:first-child {
  min-width: 0;
}

.artist-heading {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 100%;
  margin-top: 12rpx;
}

.artist-avatar {
  flex: 0 0 auto;
  width: 82rpx;
  height: 82rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: rgba(23,21,18,.08);
}

.artist-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(135deg, #2d2d30, #7f8f86);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 700;
}

.artist-name {
  flex: 1;
  min-width: 0;
  font-size: 62rpx;
  line-height: 1.05;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.step {
  font-size: 54rpx;
  font-weight: 800;
}

.step text {
  display: block;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
  text-align: center;
}

.top9-panel {
  flex: 0 0 auto;
  max-height: 344rpx;
  margin: -8rpx 0 20rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.52);
  box-sizing: border-box;
  overflow: hidden;
}

.top9-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.top9-head text {
  font-size: 28rpx;
  font-weight: 800;
}

.top9-head label,
.top9-empty {
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
  font-weight: 700;
}

.top9-selected-list {
  max-height: 268rpx;
  overflow-y: auto;
}

.top9-selected-row {
  display: grid;
  grid-template-columns: 58rpx 64rpx minmax(0, 1fr) 42rpx 46rpx;
  align-items: center;
  gap: 12rpx;
  min-height: 92rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid rgba(23,21,18,.08);
  box-sizing: border-box;
  transform: translateZ(0);
  transition: transform 160ms ease, background-color 160ms ease, box-shadow 160ms ease, opacity 160ms ease;
}

.top9-selected-row.dragging {
  z-index: 2;
  opacity: .96;
  transform: scale(1.018);
  border-radius: 10rpx;
  background: rgba(223,238,227,.78);
  box-shadow: 0 12rpx 28rpx rgba(23,21,18,.12);
}

.top9-selected-row.reflowing {
  animation: top9Reflow 180ms ease;
}

.top9-selected-row:last-child {
  border-bottom: 0;
}

.top9-rank {
  color: #3d7f5a;
  font-size: 24rpx;
  font-weight: 900;
}

.top9-cover {
  width: 64rpx;
  height: 64rpx;
  border-radius: 6rpx;
  background: rgba(23,21,18,.08);
}

.top9-title {
  min-width: 0;
  font-size: 26rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top9-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  color: #827b70;
  border-radius: 50%;
  background: rgba(23,21,18,.06);
  font-size: 30rpx;
  line-height: 1;
}

.top9-drag-handle {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 58rpx;
  border-radius: 10rpx;
  background: rgba(23,21,18,.045);
}

.top9-drag-handle view {
  width: 22rpx;
  height: 3rpx;
  margin: 3rpx 0;
  border-radius: 999rpx;
  background: rgba(23,21,18,.42);
}

.top9-selected-row.dragging .top9-drag-handle {
  background: rgba(31,122,72,.16);
}

.top9-selected-row.dragging .top9-drag-handle view {
  background: #1f7a48;
}

@keyframes top9Reflow {
  0% {
    transform: scale(.985);
  }
  100% {
    transform: scale(1);
  }
}

.song-list {
  flex: 1 1 auto;
  min-height: 0;
  gap: 10rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.song-item {
  display: grid;
  grid-template-columns: 88rpx minmax(0, 1fr);
  align-items: center;
  column-gap: 18rpx;
  width: 100%;
  min-width: 0;
  min-height: 104rpx;
  margin: 0;
  padding: 8rpx 0;
  box-sizing: border-box;
  color: #22222a;
  border-radius: 8rpx;
  background: transparent;
  border: 0;
  text-align: left;
  line-height: 1.2;
}

.song-item::after {
  border: 0;
}

.song-item.selected {
  background: rgba(61,127,90,.1);
}

.song-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: 6rpx;
  background: rgba(23,21,18,.08);
  display: block;
}

.song-info {
  min-width: 0;
}

.song-title {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 31rpx;
  line-height: 1.28;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-meta {
  margin-top: 6rpx;
  color: #8c8a90;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  line-height: 1.28;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline {
  flex: 0 0 auto;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: auto;
  padding-top: 18rpx;
  overflow-x: auto;
}

.dot {
  position: relative;
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 50%;
  background: rgba(255,255,255,.5);
  overflow: hidden;
}

.dot.done {
  background: #3d7f5a;
}

.dot.half::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 50%;
  height: 100%;
  background: #3d7f5a;
}

.nav-actions {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx;
  overflow: hidden;
}

.nav-actions.top9-actions {
  grid-template-columns: 1fr;
}

.nav-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
}
