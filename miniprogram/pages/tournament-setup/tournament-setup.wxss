@import "../../styles/song-row.wxss";

.tournament-setup-page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.setup-heading {
  margin-bottom: 24rpx;
}

.setup-heading .serif-title {
  margin: 12rpx 0 8rpx;
}

.size-section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  overflow: hidden;
}

.size-grid,
.state-actions,
.setup-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.size-card {
  display: flex;
  flex-direction: column;
  min-height: 108rpx;
  max-width: 100%;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
  overflow: hidden;
  line-height: 1.2;
}

.size-card::after {
  border: 0;
}

.size-card.selected {
  color: #fffdfa;
  border-color: #171512;
  background: #171512;
}

.size-card text {
  font-size: 30rpx;
}

.size-card label {
  margin-top: 5rpx;
  font-size: 18rpx;
  font-weight: 600;
  opacity: .72;
}

.error-panel .muted {
  margin-bottom: 24rpx;
}

.pool-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin: 0 0 16rpx;
}

.pool-heading-copy {
  min-width: 0;
}

.pool-heading .title {
  font-size: 38rpx;
  line-height: 1.15;
  white-space: nowrap;
}

.pool-count {
  display: block;
  margin-top: 5rpx;
  color: #827b70;
  font-size: 21rpx;
  font-weight: 700;
}

.pool-heading-actions {
  display: grid;
  grid-template-columns: repeat(2, 104rpx);
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.pool-heading .compact-button {
  width: 104rpx;
  min-width: 0;
  min-height: 58rpx;
  margin: 0;
  padding: 0;
  font-size: 21rpx;
  line-height: 1;
}

.pool-preview {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-bottom: 0;
  padding: 18rpx 20rpx;
}

.pool-preview-covers {
  display: flex;
  flex: 0 0 auto;
  padding-left: 14rpx;
}

.pool-preview-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: -14rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 3rpx solid #f6f0e7;
  border-radius: 8rpx;
  color: #fffdfa;
  background: #171512;
  font-size: 22rpx;
  font-weight: 800;
}

.pool-preview-cover image {
  width: 100%;
  height: 100%;
}

.pool-preview-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.pool-preview-copy view {
  font-size: 25rpx;
  font-weight: 800;
}

.pool-preview-copy text {
  display: block;
  margin-top: 5rpx;
  color: #827b70;
  font-size: 20rpx;
  font-weight: 700;
}

.pool-preview-arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #827b70;
  font-size: 40rpx;
}

.pool-list {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.pool-row {
  grid-template-columns: 88rpx minmax(0, 1fr);
  border-bottom: 1rpx solid rgba(23,21,18,.08);
}

.pool-row:last-child {
  border-bottom: 0;
}

.song-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdfa;
  background: #171512;
  font-size: 32rpx;
  font-weight: 900;
}

.setup-actions {
  margin-top: 24rpx;
}

.setup-actions button {
  width: 100%;
  margin: 0;
}
