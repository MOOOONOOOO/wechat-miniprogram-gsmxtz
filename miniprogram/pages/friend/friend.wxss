.avatars {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  color: #fff;
  border-radius: 50%;
  background: #171512;
  font-size: 34rpx;
  font-weight: 800;
  overflow: hidden;
}

.avatar.friend {
  background: #3d7f5a;
}

.avatar image {
  width: 88rpx;
  height: 88rpx;
}

.invite .serif-title {
  margin-top: 18rpx;
  margin-bottom: 24rpx;
}

.inviter-name {
  color: #827b70;
  font-size: 24rpx;
  font-weight: 700;
}

.start {
  margin-top: 28rpx;
}

.friend-actions {
  display: grid;
  gap: 18rpx;
  margin-top: 28rpx;
}

.friend-actions .start {
  width: 100%;
  margin-top: 0;
}

.joined-panel {
  margin-top: 28rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid rgba(23,21,18,.1);
  border-radius: 10rpx;
  background: rgba(246,240,231,.48);
}

.joined-copy {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.joined-copy view {
  color: #171512;
  font-size: 25rpx;
  font-weight: 800;
}

.joined-copy text {
  flex: 0 0 auto;
  color: #827b70;
  font-size: 22rpx;
  font-weight: 700;
}

.joined-avatars {
  display: grid;
  grid-template-columns: repeat(5, 64rpx);
  gap: 14rpx;
  align-items: center;
}

.joined-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  color: #fffdfa;
  border-radius: 50%;
  background: #171512;
  font-size: 24rpx;
  font-weight: 800;
  overflow: hidden;
}

.joined-avatar image {
  display: block;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.joined-extra {
  color: #171512;
  background: #e4ded4;
  font-size: 22rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.profile-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  min-width: 76rpx;
  min-height: 76rpx;
  max-width: 76rpx;
  max-height: 76rpx;
  margin: 0 18rpx 0 0;
  padding: 0;
  line-height: 76rpx;
  color: #fff;
  border-radius: 50%;
  background: #3d7f5a;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
}

.profile-avatar::after {
  border: 0;
}

.profile-avatar image {
  display: block;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.avatar-picker {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
}

.avatar-picker::after {
  border: 0;
}

.profile-name {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0;
  border: 0;
  background: transparent;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 700;
}

.profile-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(23, 21, 18, .34);
}

.profile-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 42rpx 36rpx 36rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 18rpx;
  background: #fffdfa;
  box-shadow: 0 22rpx 60rpx rgba(23, 21, 18, .18);
}

.profile-modal-title {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.profile-modal-copy {
  margin-top: 12rpx;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
}

.modal-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 116rpx;
  min-width: 116rpx;
  min-height: 116rpx;
  max-width: 116rpx;
  max-height: 116rpx;
  margin: 34rpx auto 28rpx;
  padding: 0;
  box-sizing: border-box;
  line-height: 116rpx;
  color: #fff;
  border-radius: 999rpx;
  background: #3d7f5a;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 800;
}

.modal-avatar::after {
  border: 0;
}

.modal-avatar image {
  display: block;
  width: 116rpx;
  height: 116rpx;
  border-radius: 999rpx;
}

.modal-name {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.14);
  border-radius: 12rpx;
  background: rgba(246,240,231,.58);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 700;
}

.modal-confirm {
  width: 100%;
  margin-top: 28rpx;
}
