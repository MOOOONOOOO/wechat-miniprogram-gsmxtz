.poster-page {
  padding: 18rpx;
}

.poster {
  padding: 34rpx 28rpx 42rpx;
  background:
    linear-gradient(rgba(255,255,255,.76), rgba(255,255,255,.76)),
    repeating-linear-gradient(100deg, rgba(0,0,0,.03) 0 1px, transparent 1px 5px),
    #f4eee5;
}

.poster-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.poster-head text {
  font-size: 30rpx;
  font-weight: 800;
}

.poster-avatars {
  display: flex;
  align-items: center;
}

.poster-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border: 6rpx solid #fff;
  border-radius: 50%;
  overflow: hidden;
  color: #fff;
  background: #171512;
  font-size: 28rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.poster-avatar::after {
  border: 0;
}

.poster-avatar + .poster-avatar {
  margin-left: -18rpx;
  background: #3d7f5a;
}

.poster-avatar image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.poster-avatar .avatar-placeholder {
  font-size: 15rpx;
}

.avatar-picker {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
}

.avatar-picker::after {
  border: 0;
}

.headline {
  margin-bottom: 14rpx;
  font-size: 54rpx;
  line-height: 1.14;
  font-weight: 800;
}

.top9-poster-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 180rpx;
  gap: 24rpx;
  align-items: start;
  margin-bottom: 12rpx;
}

.top9-poster-hero .top9-poster-headline {
  grid-column: 1 / -1;
  width: 100%;
  margin-bottom: 0;
  font-size: 50rpx;
  line-height: 1.12;
}

.top9-poster-hero-copy {
  min-width: 0;
}

.top9-poster-hero .headline {
  margin-bottom: 16rpx;
}

.top9-poster-hero .top9-poster-headline {
  margin-bottom: 0;
}

.top9-poster-hero .quote {
  max-width: 100%;
  margin-top: 10rpx;
}

.top9-poster-artist-cover {
  width: 180rpx;
  height: 180rpx;
  margin-top: 30rpx;
  border-radius: 12rpx;
  background: rgba(23,21,18,.08);
}

.top9-poster-artist-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #171512;
  font-size: 58rpx;
  font-weight: 900;
}

.top9-match-pill {
  display: inline-flex;
  align-items: center;
  margin: 2rpx 0 16rpx;
  padding: 12rpx 24rpx;
  border: 1rpx solid rgba(61,127,90,.22);
  border-radius: 8rpx;
  background: rgba(227,239,230,.82);
  font-size: 28rpx;
  font-weight: 900;
}

.top9-match-pill text {
  margin-left: 10rpx;
  color: #3d7f5a;
}

.poster-score-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  max-width: 620rpx;
  margin-bottom: 16rpx;
}

.poster-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -8rpx;
}

.top9-poster-summary {
  margin: 8rpx 0 18rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: rgba(227,239,230,.82);
}

.top9-poster-summary > view:first-child {
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.top9-poster-summary text {
  display: block;
  margin-top: 8rpx;
  color: #5c554d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 700;
}

.poster-match-row {
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr);
  gap: 14rpx;
  align-items: flex-start;
  min-height: 78rpx;
  margin-top: 16rpx;
}

.poster-match-row image {
  width: 64rpx;
  height: 64rpx;
  border-radius: 6rpx;
}

.poster-match-row view {
  min-width: 0;
}

.poster-match-row view text {
  margin: 0;
  color: #171512;
  font-size: 25rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poster-match-row label {
  display: block;
  margin-top: 5rpx;
  color: #3d7f5a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 20rpx;
  line-height: 1.25;
  font-weight: 800;
}

.poster-match-row .poster-rank-hit {
  color: #6b6258;
  font-size: 18rpx;
  line-height: 1.25;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top9-poster-compare {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 18rpx 0;
}

.top9-poster-column {
  min-width: 0;
  padding: 16rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,.64);
}

.top9-poster-column > view:first-child {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.poster-top9-row {
  display: grid;
  grid-template-columns: 34rpx 42rpx minmax(0, 1fr);
  gap: 10rpx;
  align-items: center;
  min-height: 50rpx;
  margin-top: 8rpx;
  padding: 4rpx 6rpx;
  border-radius: 8rpx;
}

.poster-top9-row.matched {
  background: rgba(61,127,90,.11);
}

.poster-top9-row text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  color: #3d7f5a;
  background: rgba(61,127,90,.14);
  font-size: 17rpx;
  font-weight: 900;
}

.poster-top9-row image {
  width: 42rpx;
  height: 42rpx;
  border-radius: 6rpx;
  background: rgba(23,21,18,.08);
}

.poster-top9-row label {
  display: block;
  min-width: 0;
  color: #171512;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poster-tile {
  width: 31.8%;
  margin-right: 8rpx;
  margin-bottom: 14rpx;
  color: #171512;
}

.cover-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  height: auto;
  overflow: hidden;
  background: #171512;
}

.cover-wrap image {
  width: 100%;
  height: 100%;
  opacity: .82;
}

.artist-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #171512;
}

.badge {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  padding: 8rpx 12rpx;
  background: #3d7f5a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 18rpx;
  font-weight: 800;
}

.badge.no {
  background: rgba(106,103,100,.86);
}

.poster-score {
  flex: 0 0 auto;
  margin: 0;
  font-size: 88rpx;
  line-height: 1;
  font-weight: 800;
}

.quote {
  flex: 1;
  min-width: 0;
  max-width: 420rpx;
  margin: 0;
  color: #6f6961;
  font-size: 28rpx;
  line-height: 1.18;
}

.columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.column {
  min-height: 190rpx;
  padding: 18rpx;
  border-radius: 6rpx;
  background: rgba(255,255,255,.58);
}

.column.ok {
  color: #3d7f5a;
  background: rgba(227,239,230,.75);
}

.column > text {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.column view {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(23,21,18,.13);
  color: #171512;
  font-size: 24rpx;
}

.poster-foot {
  display: grid;
  grid-template-columns: 1fr 160rpx;
  gap: 28rpx;
  align-items: end;
  margin-top: 18rpx;
}

.poster-foot > view:first-child {
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 1.1;
}

.qr {
  text-align: center;
}

.qr view,
.qr image {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 6rpx;
}

.qr image {
  display: block;
  background: #fff;
}

.qr view {
  border: 12rpx solid #fff;
  background:
    linear-gradient(90deg, #111 10%, transparent 10% 20%, #111 20% 30%, transparent 30% 50%, #111 50% 60%, transparent 60%),
    linear-gradient(#111 10%, transparent 10% 22%, #111 22% 32%, transparent 32% 48%, #111 48% 58%, transparent 58%);
  background-size: 28rpx 28rpx;
}

.qr .qr-empty {
  border: 0;
  background: #fff;
}

.qr text {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  color: #6f6961;
  font-size: 16rpx;
  font-weight: 800;
}

.poster-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.poster-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.poster-canvas {
  position: fixed;
  left: -2400px;
  top: -2400px;
  width: 750px;
  height: 1600px;
}
