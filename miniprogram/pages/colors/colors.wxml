<view class="page color-page">
  <view class="color-head">
    <view>
      <view class="serif-title">颜色推歌挑战</view>
      <view class="muted">点一个颜色，选一首适合它的歌。</view>
    </view>
    <view class="color-count">{{selectedCount}}<text>/9</text></view>
  </view>

  <view class="color-grid">
    <button
      wx:for="{{colors}}"
      wx:key="id"
      class="color-card {{item.doneClass}} {{item.darkClass}}"
      style="{{item.cardStyle}}"
      data-id="{{item.id}}"
      bindtap="chooseColor"
    >
      <view class="color-name">{{item.name}}</view>
      <view class="color-cover-wrap">
        <view class="color-cover-box">
          <image wx:if="{{item.song.cover}}" class="color-cover" src="{{item.song.cover}}" mode="aspectFill"></image>
          <view wx:else class="color-empty">+</view>
        </view>
      </view>
      <view class="color-info">
        <view class="song-title">{{item.songName}}</view>
        <view class="song-meta">{{item.songArtistName}}</view>
        <view class="song-album">{{item.songAlbumName}}</view>
      </view>
    </button>
  </view>

  <view class="color-actions {{actionClass}}">
    <button wx:if="{{role !== 'friend'}}" class="secondary-button" disabled="{{!isComplete || savingImage}}" bindtap="saveImage">{{savingImage ? "绘制中" : "仅保存图片"}}</button>
    <button class="primary-button" disabled="{{!isComplete || creating}}" bindtap="primaryAction">{{primaryLabel}}</button>
  </view>

  <canvas canvas-id="colorCanvas" class="color-canvas"></canvas>

  <view wx:if="{{showCreatorProfileModal}}" class="creator-profile-modal-mask">
    <view class="creator-profile-modal">
      <view class="creator-profile-modal-title">先设置你的资料</view>
      <view class="creator-profile-modal-copy">{{creatorProfileModalCopy}}</view>
      <button class="creator-modal-avatar" open-type="chooseAvatar" bindchooseavatar="onChooseCreatorAvatar">
        <image wx:if="{{creatorProfileDraft.avatarUrl}}" src="{{creatorProfileDraft.avatarUrl}}" mode="aspectFill"></image>
        <text wx:else>头像</text>
      </button>
      <input
        class="creator-modal-input"
        type="nickname"
        value="{{creatorProfileDraft.nickName}}"
        bindinput="onCreatorNicknameInput"
        placeholder="填写昵称"
      />
      <button
        class="primary-button creator-modal-confirm"
        disabled="{{!creatorProfileDraft.avatarUrl || !creatorProfileDraft.nickName}}"
        bindtap="confirmCreatorProfileModal"
      >{{creatorProfileModalConfirmText}}</button>
    </view>
  </view>
</view>
