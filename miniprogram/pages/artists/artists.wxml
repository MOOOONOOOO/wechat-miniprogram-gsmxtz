<view class="page">
  <view class="search">
    <text>⌕</text>
    <input value="{{query}}" bindinput="onSearchInput" placeholder="{{isAlbumMode ? '搜索任意 iTunes 歌手或专辑' : '搜索任意 iTunes 歌手'}}" />
  </view>

  <view class="section-row">
    <view class="title">{{titleText}}</view>
    <text class="label">{{isAlbumMode ? albumCount : selected.length}}/{{targetCount}}</text>
  </view>

  <view class="tabs">
    <text wx:for="{{letterItems}}" wx:key="key" class="{{item.activeClass}}" bindtap="setLetter" data-letter="{{item.key}}">{{item.key}}</text>
  </view>

  <view wx:if="{{showSearchSections}}" class="artist-list search-sections">
    <view class="result-section">
      <view class="result-heading">
        <text>专辑</text>
        <label>{{visibleAlbums.length}}</label>
      </view>
      <view
        wx:for="{{visibleAlbums}}"
        wx:key="id"
        class="artist-row album-row {{item.selectedClass}}"
        data-id="{{item.id}}"
        data-type="album"
        bindtap="toggleArtist"
      >
        <image wx:if="{{item.avatarUrl}}" class="artist-avatar artist-avatar-image album-cover" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="artist-avatar artist-avatar-fallback">{{item.avatar}}</view>
        <view class="artist-copy">
          <view>
            <text class="artist-name">{{item.name}}</text>
            <text wx:if="{{item.meta}}" class="artist-meta">{{item.meta}}</text>
          </view>
          <text wx:if="{{item.selectedClass}}" class="selected-mark">✓</text>
        </view>
      </view>
      <view wx:if="{{visibleAlbums.length === 0 && !loading}}" class="empty-result">没有搜到专辑</view>
    </view>

    <view class="result-section">
      <view class="result-heading">
        <text>歌手</text>
        <label>{{visibleArtistResults.length}}</label>
      </view>
      <view
        wx:for="{{visibleArtistResults}}"
        wx:key="id"
        class="artist-row {{item.selectedClass}}"
        data-id="{{item.id}}"
        data-type="artist"
        bindtap="toggleArtist"
      >
        <image wx:if="{{item.avatarUrl}}" class="artist-avatar artist-avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="artist-avatar artist-avatar-fallback">{{item.avatar}}</view>
        <view class="artist-copy">
          <view>
            <text class="artist-name">{{item.name}}</text>
            <text wx:if="{{item.meta}}" class="artist-meta">{{item.meta}}</text>
          </view>
          <text wx:if="{{item.selectedClass}}" class="selected-mark">✓</text>
        </view>
      </view>
      <view wx:if="{{visibleArtistResults.length === 0 && !loading}}" class="empty-result">没有搜到歌手</view>
    </view>
  </view>

  <view wx:else class="artist-list">
    <view
      wx:for="{{visibleArtists}}"
      wx:key="id"
      class="artist-row {{item.type === 'album' ? 'album-row' : ''}} {{item.selectedClass}}"
      data-id="{{item.id}}"
      data-type="{{item.type}}"
      bindtap="toggleArtist"
    >
      <image wx:if="{{item.avatarUrl}}" class="artist-avatar artist-avatar-image {{item.type === 'album' ? 'album-cover' : ''}}" src="{{item.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="artist-avatar artist-avatar-fallback">{{item.avatar}}</view>
      <view class="artist-copy">
        <view>
          <text class="artist-name">{{item.name}}</text>
          <text wx:if="{{item.meta}}" class="artist-meta">{{item.meta}}</text>
        </view>
        <text wx:if="{{item.selectedClass}}" class="selected-mark">✓</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">正在从 iTunes 搜索{{isAlbumMode ? '专辑和歌手' : '歌手'}}...</view>

  <view class="bottom-action">
    <button wx:if="{{mode === 'album'}}" class="primary-button" disabled="{{!canNext}}" bindtap="next">下一步：每张专辑选 1 首</button>
    <button wx:elif="{{mode === 'themeAlbum'}}" class="primary-button" disabled="{{!canNext}}" bindtap="next">{{themeAlbumDoneText}}</button>
    <button wx:elif="{{mode === 'top9'}}" class="primary-button" disabled="{{!canNext}}" bindtap="next">下一步：选择 Top9 歌曲</button>
    <button wx:elif="{{mode === 'color'}}" class="primary-button" disabled="{{!canNext}}" bindtap="next">下一步：为这个颜色选歌</button>
    <button wx:elif="{{mode === 'qa'}}" class="primary-button" disabled="{{!canNext}}" bindtap="next">下一步：为这个问题选歌</button>
    <button wx:elif="{{mode === 'theme'}}" class="primary-button" disabled="{{!canNext}}" bindtap="next">下一步：为这个题目选歌</button>
    <button wx:else class="primary-button" disabled="{{!canNext}}" bindtap="next">下一步：每位歌手选 1 首</button>
  </view>
</view>
