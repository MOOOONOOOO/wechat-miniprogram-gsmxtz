.notice-page {
  padding-bottom: 56rpx;
}

.notice-head {
  margin: 18rpx 0 24rpx;
}

.notice-title {
  margin-top: 8rpx;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
}

.notice-segment {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-bottom: 22rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.46);
}

.notice-segment text {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 8rpx;
  color: #5c554d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 25rpx;
  font-weight: 900;
}

.notice-segment text.active {
  color: #fffdfa;
  background: #171512;
}

.feedback-panel {
  display: grid;
  gap: 16rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 8rpx;
  background: rgba(255,255,255,.62);
}

.feedback-panel textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.12);
  border-radius: 6rpx;
  background: #fffdfa;
  color: #171512;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 26rpx;
  font-weight: 700;
}

.feedback-panel textarea {
  min-height: 300rpx;
  padding: 20rpx;
  line-height: 1.45;
}

.feedback-panel button {
  width: 100%;
  margin: 0;
}

.announcement-list {
  display: grid;
  gap: 18rpx;
}

.announcement-card,
.notice-empty {
  padding: 24rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 8rpx;
  background: rgba(255,255,255,.62);
}

.announcement-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 21rpx;
  font-weight: 800;
}

.announcement-meta text {
  padding: 4rpx 10rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 6rpx;
  color: #171512;
}

.announcement-title {
  margin-top: 14rpx;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
}

.announcement-content {
  margin-top: 12rpx;
  color: #5f584f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 25rpx;
  line-height: 1.55;
  font-weight: 700;
}

.announcement-content text {
  display: block;
  min-height: 1.55em;
}

.notice-empty view {
  font-size: 32rpx;
  font-weight: 900;
}

.notice-empty text {
  display: block;
  margin-top: 8rpx;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  font-weight: 700;
}
