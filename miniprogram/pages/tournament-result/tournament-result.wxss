.tournament-result-page {
  min-height: 100vh;
  padding: 0 0 calc(38rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f6f0e7;
}

.result-poster-shell {
  width: 750rpx;
  height: 1050rpx;
  margin: 0 auto;
  padding: 0;
  overflow: hidden;
  border-radius: 0;
  background: #f2eadf;
  box-shadow: none;
}

.result-poster {
  position: relative;
  width: 750rpx;
  height: 1050rpx;
  overflow: hidden;
  color: #171512;
  background:
    radial-gradient(circle at 50% 42%, rgba(227,239,216,.82), transparent 31%),
    linear-gradient(145deg, #fffdfa 0%, #f4ede3 54%, #eee5d9 100%);
}

.result-poster-image {
  display: block;
  width: 750rpx;
  height: 1050rpx;
  background: #f2eadf;
}

.poster-atmosphere,
.poster-grain {
  position: absolute;
  pointer-events: none;
}

.poster-atmosphere {
  z-index: 0;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  opacity: .34;
}

.poster-atmosphere-left {
  left: -170rpx;
  top: 250rpx;
  background: radial-gradient(circle, rgba(217,241,242,.95), transparent 68%);
}

.poster-atmosphere-right {
  right: -165rpx;
  top: 235rpx;
  background: radial-gradient(circle, rgba(245,223,220,.92), transparent 68%);
}

.poster-grain {
  z-index: 1;
  inset: 0;
  opacity: .25;
  background-image:
    radial-gradient(circle at 18% 26%, rgba(23,21,18,.16) 0 1rpx, transparent 1.5rpx),
    radial-gradient(circle at 74% 62%, rgba(23,21,18,.1) 0 1rpx, transparent 1.5rpx);
  background-size: 79rpx 71rpx, 91rpx 83rpx;
}

.poster-header {
  position: absolute;
  z-index: 8;
  top: 106rpx;
  left: 0;
  width: 100%;
  text-align: center;
}

.poster-title {
  font-family: "Songti SC", "Times New Roman", serif;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0;
  white-space: pre;
}

.poster-artist-line {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
  color: #5c554d;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.poster-edge {
  position: absolute;
  z-index: 2;
  height: 1rpx;
  transform-origin: 0 50%;
  background: rgba(23,21,18,.2);
}

.poster-edge.winner-edge {
  z-index: 3;
  height: 2rpx;
  background: #3d7f5a;
  box-shadow: 0 0 6rpx rgba(61,127,90,.28);
}

.poster-cover-node {
  position: absolute;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 5rpx;
  overflow: hidden;
  padding: 4rpx;
  box-sizing: border-box;
  color: #171512;
  border: 1rpx solid #cfc9c0;
  border-radius: 6rpx;
  background: #fffdfa;
  box-shadow: 0 3rpx 8rpx rgba(23,21,18,.12);
}

.poster-cover-node.winner-node {
  z-index: 6;
  color: #1f6f42;
  border-color: #3d7f5a;
  background: rgba(227,239,216,.96);
  box-shadow: 0 4rpx 10rpx rgba(61,127,90,.18);
}

.poster-node-art {
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 3rpx;
  background: #e8dfd2;
}

.poster-node-art image,
.poster-cover-fallback {
  display: block;
  width: 100%;
  height: 100%;
}

.poster-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdfa;
  background: #171512;
  font-size: 9rpx;
  font-weight: 800;
}

.poster-node-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  color: #171512;
  font-weight: 800;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poster-finalist-label {
  position: absolute;
  z-index: 7;
  color: #171512;
  font-size: 11rpx;
  line-height: 1.2;
  text-align: center;
}

.poster-finalist-label text {
  display: block;
  margin-bottom: 3rpx;
  color: #3d7f5a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 8rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.poster-champion {
  position: absolute;
  z-index: 9;
  left: 50%;
  top: 479rpx;
  width: 248rpx;
  transform: translateX(-50%);
  text-align: center;
}

.poster-champion-label {
  margin-bottom: 7rpx;
  color: #3d7f5a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 10rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
  text-indent: 5rpx;
}

.poster-champion-cover {
  width: 147rpx;
  height: 147rpx;
  margin: 0 auto;
  overflow: hidden;
  border: 2rpx solid #3d7f5a;
  border-radius: 7rpx;
  background: #e8dfd2;
  box-shadow:
    6rpx 6rpx 0 rgba(61,127,90,.16),
    0 14rpx 27rpx rgba(23,21,18,.18);
}

.poster-champion-cover image,
.poster-champion-fallback {
  display: block;
  width: 100%;
  height: 100%;
}

.poster-champion-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdfa;
  background: #171512;
  font-size: 34rpx;
  font-weight: 800;
}

.poster-champion-name {
  max-width: 280rpx;
  margin: 11rpx auto 0;
  overflow: hidden;
  font-size: 25rpx;
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poster-champion-album {
  max-width: 260rpx;
  margin: 6rpx auto 0;
  overflow: hidden;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 9rpx;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poster-footer {
  position: absolute;
  z-index: 8;
  left: 50%;
  bottom: 170rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  transform: translateX(-50%);
}

.poster-footer.without-qr {
  justify-content: center;
}

.poster-qr {
  display: block;
  width: 54rpx;
  height: 54rpx;
  padding: 4rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.18);
  border-radius: 4rpx;
  background: #fffdfa;
}

.poster-brand {
  padding-left: 12rpx;
  border-left: 1rpx solid rgba(23,21,18,.18);
  white-space: nowrap;
}

.without-qr .poster-brand {
  padding-left: 0;
  border-left: 0;
  text-align: center;
}

.poster-brand view {
  font-size: 14rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.poster-brand text {
  display: block;
  margin-top: 5rpx;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 8rpx;
  letter-spacing: 1rpx;
}

.result-actions {
  padding: 20rpx 28rpx 0;
}

.result-actions button {
  width: 100%;
  margin: 0;
}

.save-poster-button {
  min-height: 82rpx;
  margin-top: 14rpx !important;
}

.tournament-share-button {
  min-height: 96rpx;
}

.result-secondary-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.result-secondary-actions button {
  min-height: 82rpx;
}

.poster-canvas {
  position: fixed;
  left: -4000px;
  top: 0;
  pointer-events: none;
}

.result-invalid {
  width: calc(100% - 56rpx);
  margin: 92rpx auto 0;
  color: #171512;
  text-align: center;
}

.result-invalid .primary-button {
  width: 100%;
  margin-top: 28rpx;
}
