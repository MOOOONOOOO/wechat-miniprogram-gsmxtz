@import "../songs/songs.wxss";

.tournament-match-page {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.invalid-state {
  margin-top: 120rpx;
  text-align: center;
}

.invalid-state .serif-title,
.invalid-state .muted {
  display: block;
  margin-bottom: 28rpx;
}

.tournament-progress {
  grid-template-columns: minmax(0, 1fr) auto;
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
}

.tournament-stage-title {
  font-size: 21rpx;
  letter-spacing: .5rpx;
}

.tournament-stage-copy {
  margin-top: 7rpx;
  font-size: 42rpx;
  line-height: 1.08;
  font-weight: 900;
}

.tournament-progress .step {
  min-width: 72rpx;
  font-size: 30rpx;
  line-height: 1;
  text-align: right;
}

.overall-row {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: auto minmax(100rpx, 1fr);
  align-items: center;
  gap: 18rpx;
  margin-bottom: 14rpx;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 21rpx;
  font-weight: 700;
}

.overall-track {
  height: 6rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(23,21,18,.1);
}

.overall-track view {
  height: 100%;
  border-radius: inherit;
  background: #3d7f5a;
  transition: width 220ms ease;
}

.tournament-card-scroll {
  flex: 1 1 auto;
  min-height: 0;
  padding: 0 0 8rpx;
  overflow: hidden;
}

.tournament-card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  column-gap: 12rpx;
  row-gap: 12rpx;
  width: 100%;
  max-width: 100%;
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.tournament-card-grid.four-cards {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: auto;
  column-gap: 20rpx;
  row-gap: 20rpx;
  padding: 10rpx 8rpx 16rpx;
}

.tournament-card-grid.two-cards {
  gap: 32rpx;
  padding: 12rpx 18rpx 26rpx;
}

.tournament-song-card {
  position: relative;
  display: block;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 14rpx;
  box-sizing: border-box;
  color: #171512;
  text-align: left;
  line-height: 1.2;
  opacity: 1;
  transform: translateZ(0);
  transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease, opacity 160ms ease;
}

.four-cards .tournament-song-card {
  display: block;
  height: auto;
  min-height: 0;
  padding: 0;
  overflow: hidden;
}

.tournament-song-card.selected {
  border-color: rgba(31,111,66,.68);
  background: rgba(61,127,90,.12);
  transform: translateY(-2rpx);
}

.four-cards .tournament-song-card.selected {
  z-index: 2;
  box-shadow: 0 7rpx 14rpx rgba(31,111,66,.18);
  transform: translateY(-8rpx);
}

.two-cards .tournament-song-card.advanced {
  z-index: 3;
  border-color: rgba(31,111,66,.78);
  background: rgba(61,127,90,.16);
  box-shadow: 0 18rpx 42rpx rgba(31,111,66,.2);
  transform: none;
}

.two-cards .tournament-song-card.advanced .tournament-card-cover image,
.two-cards .tournament-song-card.advanced .tournament-card-fallback {
  animation: tournamentWinnerArtwork 580ms cubic-bezier(.18,.88,.25,1.18) both;
}

.two-cards .tournament-song-card.eliminated {
  z-index: 1;
  pointer-events: none;
  animation: tournamentLoser 520ms cubic-bezier(.4,0,.7,1) both;
}

.tournament-card-cover {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  overflow: hidden;
  border-radius: 6rpx;
  background: rgba(23,21,18,.08);
}

.four-cards .tournament-card-cover {
  height: 0;
  padding-bottom: 100%;
  border-radius: 10rpx 10rpx 0 0;
  background: transparent;
}

.four-cards .tournament-card-cover image {
  background: transparent;
}

.tournament-card-cover image,
.tournament-card-fallback {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.tournament-card-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdfa;
  background: #171512;
  font-size: 58rpx;
  font-weight: 900;
}

.tournament-card-copy {
  min-width: 0;
  padding: 12rpx 2rpx 2rpx;
}

.four-cards .tournament-card-copy {
  flex: 0 0 auto;
  padding: 9rpx 12rpx 11rpx;
}

.tournament-card-title {
  display: -webkit-box;
  min-height: 66rpx;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.four-cards .tournament-card-title {
  display: block;
  min-height: 0;
  overflow: hidden;
  font-size: 24rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tournament-card-meta {
  margin-top: 7rpx;
  overflow: hidden;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 21rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.four-cards .tournament-card-meta {
  margin-top: 3rpx;
  font-size: 18rpx;
}

.song-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdfa;
  background: #171512;
  font-size: 32rpx;
  font-weight: 900;
}

.choice-state {
  position: absolute;
  z-index: 2;
  right: 10rpx;
  bottom: 10rpx;
  padding: 7rpx 11rpx;
  color: #827b70;
  border-radius: 999rpx;
  background: rgba(255,253,250,.9);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 20rpx;
  font-weight: 800;
}

.four-cards .choice-state {
  right: 7rpx;
  bottom: 7rpx;
  padding: 5rpx 8rpx;
  font-size: 17rpx;
}

.tournament-song-card.selected .choice-state {
  color: #fffdfa;
  background: #3d7f5a;
}

.tournament-actions {
  flex: 0 0 auto;
  margin-top: 10rpx;
  padding: 12rpx;
}

.secondary-action-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.tournament-actions button {
  min-height: 76rpx;
}

.tournament-actions button {
  width: 100%;
  margin: 0;
}

.pair-tip {
  padding: 8rpx 4rpx 2rpx;
  font-size: 23rpx;
  text-align: center;
}

.tournament-round-modal {
  max-height: 82vh;
  text-align: left;
}

.tournament-round-modal .creator-profile-modal-title {
  margin: 12rpx 0 18rpx;
}

.round-winner-list {
  max-height: 48vh;
  margin-bottom: 22rpx;
}

.round-winner-row {
  grid-template-columns: 64rpx minmax(0, 1fr);
  min-height: 80rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid rgba(23,21,18,.08);
}

.round-winner-row .song-cover {
  width: 64rpx;
  height: 64rpx;
}

.round-undo {
  width: 100%;
  margin-top: 14rpx;
}

@keyframes tournamentWinnerArtwork {
  0% {
    transform: scale(1);
  }
  68% {
    transform: scale(1.1);
  }
  100% {
    transform: scale(1.07);
  }
}

@keyframes tournamentLoser {
  0% {
    opacity: 1;
    transform: scale(1) translateY(0);
    filter: grayscale(0);
  }
  55% {
    opacity: .28;
  }
  100% {
    opacity: 0;
    transform: scale(.82) translateY(18rpx);
    filter: grayscale(1);
  }
}
