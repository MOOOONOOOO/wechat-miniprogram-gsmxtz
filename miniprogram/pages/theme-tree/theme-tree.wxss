page {
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
  background: #ededed;
}

.tree-page {
  position: relative;
  width: 100%;
  max-width: 100vw;
  min-height: 100vh;
  padding: 34rpx 20rpx 150rpx;
  box-sizing: border-box;
  overflow-x: hidden;
  touch-action: pan-y;
  background: #ededed;
}

.tree-page.result-mode {
  padding-bottom: calc(290rpx + env(safe-area-inset-bottom));
}

.tree-result-copy {
  position: relative;
  z-index: 4;
  margin: 0 34rpx 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,.78);
  color: #111;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 700;
  text-align: center;
}

.tree-snow-layer {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
  opacity: 0;
  transition: opacity 180ms ease;
}

.tree-snow-layer.active {
  opacity: 1;
}

.tree-snowflake {
  position: absolute;
  top: -40rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: #fff;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.tree-snowflake.drift-left {
  animation-name: snowFallLeft;
}

.tree-snowflake.drift-center {
  animation-name: snowFallCenter;
}

.tree-snowflake.drift-right {
  animation-name: snowFallRight;
}

.chat-star {
  position: relative;
  z-index: 4;
  margin-bottom: 24rpx;
  color: #f4bf37;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 88rpx;
  line-height: 1;
  text-align: center;
  text-shadow: 0 6rpx 12rpx rgba(127,90,9,.16);
  opacity: 0;
  transform: scale(.3) rotate(-18deg);
}

.chat-star.revealed {
  animation:
    starLight 560ms cubic-bezier(.18,.89,.32,1.35) both,
    starSpin 6s linear 560ms infinite;
}

.tree-list {
  position: relative;
  z-index: 4;
  width: 100%;
}

.tree-people {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: 34rpx auto 8rpx;
  opacity: 0;
  transform: translateY(18rpx) scale(.92);
}

.tree-people.revealed {
  animation: peopleGather 560ms cubic-bezier(.18,.89,.32,1.18) both;
}

.tree-page.result-mode .tree-people {
  margin-top: 24rpx;
  margin-bottom: 72rpx;
}

.tree-person {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  width: 190rpx;
  min-width: 0;
}

.left-person {
  flex-direction: row-reverse;
}

.tree-person-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 4rpx solid rgba(255,255,255,.92);
  border-radius: 50%;
  color: #173f27;
  background: #95ec69;
  box-shadow: 0 8rpx 22rpx rgba(0,0,0,.12);
  font-size: 28rpx;
  font-weight: 800;
}

.right-person .tree-person-avatar {
  color: #555;
  background: #fff;
}

.tree-page.friend-view .left-person .tree-person-avatar {
  color: #555;
  background: #fff;
}

.tree-page.friend-view .right-person .tree-person-avatar {
  color: #173f27;
  background: #95ec69;
}

.tree-person-avatar image {
  width: 100%;
  height: 100%;
}

.tree-person-name {
  display: block;
  width: 104rpx;
  overflow: hidden;
  color: #262626;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 700;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.left-person .tree-person-name {
  text-align: right;
}

.tree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  min-height: 64rpx;
  margin-bottom: 14rpx;
}

.tree-row.first-trunk {
  margin-top: 24rpx;
}

.song-chip {
  position: relative;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  color: #111;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 400;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(16rpx) scale(.9);
}

.tree-row.revealed .song-chip {
  animation: bubbleGrow 360ms cubic-bezier(.22,.82,.31,1.16) both;
}

.tree-row.revealed .song-chip.right-bubble {
  animation-delay: 45ms;
}

.song-chip text {
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: clip;
  white-space: nowrap;
}

.tree-branch-guide {
  color: rgba(17,17,17,.72);
  font-size: 20rpx;
  line-height: 1;
  font-weight: 600;
  text-align: center;
}

.song-chip.left-bubble {
  justify-content: flex-end;
  text-align: right;
}

.song-chip.right-bubble {
  justify-content: flex-start;
  text-align: left;
}

.song-chip.mine {
  border-radius: 8rpx;
  background: #95ec69;
}

.song-chip.mine.empty {
  color: rgba(17,17,17,.38);
}

.song-chip.mine.active {
  box-shadow: 0 0 0 5rpx rgba(7,193,96,.18);
}

.empty-bubble-text {
  color: rgba(17,17,17,.46);
  font-size: 34rpx;
  font-weight: 300;
  text-align: center;
}

.song-chip.left-bubble::after {
  content: "";
  position: absolute;
  top: 22rpx;
  right: -10rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
}

.song-chip.left-bubble.mine::after {
  border-left: 12rpx solid #95ec69;
}

.song-chip.left-bubble.yours::after {
  border-left: 12rpx solid #fff;
}

.song-chip.yours {
  border-radius: 8rpx;
  background: #fff;
}

.song-chip.waiting {
  color: transparent;
}

.song-chip.yours.active {
  box-shadow: 0 0 0 5rpx rgba(255,255,255,.7), 0 0 0 8rpx rgba(7,193,96,.16);
}

.song-chip.right-bubble::before {
  content: "";
  position: absolute;
  top: 22rpx;
  left: -10rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
}

.song-chip.right-bubble.mine::before {
  border-right: 12rpx solid #95ec69;
}

.song-chip.right-bubble.yours::before {
  border-right: 12rpx solid #fff;
}

.song-chip.latin {
  font-size: 24rpx;
  letter-spacing: -.02em;
}

.tree-action-bar {
  position: fixed;
  z-index: 8;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 100vw;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  border-top: 1rpx solid rgba(0,0,0,.08);
  background: rgba(237,237,237,.96);
  display: flex;
  gap: 16rpx;
}

.tree-page.result-mode .tree-action-bar {
  padding-top: 10rpx;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
}

.tree-action-bar button {
  flex: 1;
  width: auto;
  margin: 0;
  padding-left: 12rpx;
  padding-right: 12rpx;
  font-size: 25rpx;
}

.tree-result-canvas {
  position: fixed;
  left: -2200px;
  top: 0;
  width: 1000px;
  height: 1920px;
  pointer-events: none;
}

.tree-share-canvas {
  position: fixed;
  left: -2200px;
  top: 0;
  width: 1000px;
  height: 800px;
  pointer-events: none;
}

@keyframes bubbleGrow {
  0% {
    opacity: 0;
    transform: translateY(16rpx) scale(.9);
  }
  72% {
    opacity: 1;
    transform: translateY(-2rpx) scale(1.018);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes starLight {
  0% {
    opacity: 0;
    transform: scale(.3) rotate(-18deg);
  }
  68% {
    opacity: 1;
    transform: scale(1.16) rotate(5deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
}

@keyframes peopleGather {
  0% {
    opacity: 0;
    transform: translateY(18rpx) scale(.92);
  }
  68% {
    opacity: 1;
    transform: translateY(-3rpx) scale(1.025);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes starSpin {
  from {
    transform: rotate(0);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes snowFallLeft {
  0% {
    transform: translate3d(0, -8vh, 0) rotate(0);
  }
  50% {
    transform: translate3d(28rpx, 52vh, 0) rotate(180deg);
  }
  100% {
    transform: translate3d(-34rpx, 112vh, 0) rotate(360deg);
  }
}

@keyframes snowFallCenter {
  0% {
    transform: translate3d(0, -12vh, 0) rotate(0);
  }
  50% {
    transform: translate3d(-18rpx, 50vh, 0) rotate(160deg);
  }
  100% {
    transform: translate3d(16rpx, 112vh, 0) rotate(360deg);
  }
}

@keyframes snowFallRight {
  0% {
    transform: translate3d(0, -10vh, 0) rotate(0);
  }
  50% {
    transform: translate3d(-30rpx, 54vh, 0) rotate(190deg);
  }
  100% {
    transform: translate3d(38rpx, 112vh, 0) rotate(360deg);
  }
}
