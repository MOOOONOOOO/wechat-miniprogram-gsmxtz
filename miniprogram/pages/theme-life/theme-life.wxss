.theme-life-page {
  padding: 30rpx 54rpx 170rpx;
}

.theme-life-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 24rpx;
  align-items: end;
  margin: 18rpx 0 26rpx;
}

.theme-life-head .serif-title {
  margin-bottom: 12rpx;
}

.theme-count {
  font-size: 58rpx;
  line-height: 1;
  font-weight: 900;
}

.theme-count text {
  margin-left: 4rpx;
  color: #827b70;
  font-size: 28rpx;
}

.life-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  margin: -7rpx;
  box-sizing: border-box;
}

.life-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  flex: 0 0 calc(33.333% - 14rpx);
  width: calc(33.333% - 14rpx);
  min-width: calc(33.333% - 14rpx);
  height: 276rpx;
  margin: 7rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(23,21,18,.12);
  border-radius: 4rpx;
  box-sizing: border-box;
  background: #fffdfa;
  box-shadow:
    0 1rpx 0 rgba(23,21,18,.08),
    0 14rpx 24rpx rgba(23,21,18,.11);
}

.album-title,
.album-meta {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.life-cover-wrap {
  width: 100%;
  flex: 0 0 auto;
  margin-top: 0;
}

.life-cover-box {
  position: relative;
  width: 100%;
  height: auto;
  padding-bottom: 100%;
  overflow: hidden;
  border-radius: 2rpx;
  background: #f1ebe2;
  box-shadow:
    0 0 0 1rpx rgba(255,255,255,.5) inset,
    0 8rpx 14rpx rgba(23,21,18,.12);
}

.life-cover,
.life-empty {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 2rpx;
}

.life-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(23,21,18,.22);
  color: rgba(23,21,18,.36);
  font-size: 58rpx;
  font-weight: 300;
}

.life-info {
  flex: 1;
  min-height: 0;
  margin-top: auto;
  padding-top: 16rpx;
}

.album-title {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 21rpx;
  line-height: 24rpx;
  font-weight: 900;
}

.album-meta {
  margin-top: 2rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 18rpx;
  line-height: 21rpx;
  font-weight: 700;
  opacity: .82;
}

.theme-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(23,21,18,.08);
  background: rgba(246,240,231,.94);
}

.theme-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
}

.theme-life-canvas {
  position: fixed;
  left: -2200px;
  top: -2200px;
  width: 750px;
  height: 1180px;
}
