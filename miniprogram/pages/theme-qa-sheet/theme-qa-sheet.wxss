.qa-sheet-page {
  padding: 28rpx 40rpx 150rpx;
}

.qa-sheet-head {
  margin: 18rpx 0 28rpx;
}

.qa-sheet-head .serif-title {
  margin: 8rpx 0 14rpx;
}

.qa-invite-card {
  margin: 4rpx 0 24rpx;
  padding: 30rpx 30rpx 32rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.12);
  border-radius: 12rpx;
  background: rgba(255,253,248,.82);
  box-shadow: 0 10rpx 24rpx rgba(23,21,18,.06);
}

.qa-invite-card .serif-title {
  margin: 16rpx 0 20rpx;
}

.qa-invite-profile {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  color: #171512;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 800;
}

.qa-invite-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  color: #fff;
  background: #171512;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 900;
}

.qa-invite-avatar image {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.qa-sheet-board {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.qa-sheet-cell {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 206rpx;
  padding: 16rpx 12rpx 14rpx;
  box-sizing: border-box;
  border-radius: 6rpx;
  background: rgba(255,255,255,.68);
  box-shadow:
    0 1rpx 0 rgba(255,255,255,.7) inset,
    0 10rpx 20rpx rgba(23,21,18,.08);
}

.qa-question {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 auto;
  min-height: 0;
  padding: 12rpx 2rpx;
  box-sizing: border-box;
  text-align: center;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 23rpx;
  line-height: 1.28;
  font-weight: 800;
  word-break: break-all;
}

.qa-answer-line {
  height: 42rpx;
  border-radius: 4rpx;
  background: rgba(23,21,18,.045);
}

.qa-sheet-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(23,21,18,.08);
  background: rgba(246,240,231,.94);
}

.qa-sheet-actions.single {
  grid-template-columns: minmax(0, 360rpx);
  justify-content: center;
}

.qa-sheet-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
}

.qa-invite-enter {
  width: 360rpx;
}
