.hero {
  margin-top: 14rpx;
  padding: 26rpx 28rpx;
}

.profile-row {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  margin-top: 18rpx;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  min-width: 76rpx;
  min-height: 76rpx;
  max-width: 76rpx;
  max-height: 76rpx;
  margin: 0;
  padding: 0;
  line-height: 76rpx;
  color: #fff;
  border-radius: 50%;
  background: #171512;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.profile-avatar::after {
  border: 0;
}

.profile-avatar image {
  display: block;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.profile-name {
  flex: 1 1 auto;
  min-width: 0;
  height: 76rpx;
  margin-left: 28rpx;
  padding-left: 0;
  border: 0;
  background: transparent;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 700;
}

.profile-picker {
  position: absolute;
  left: 0;
  top: 0;
  width: 76rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  opacity: 0;
}

.profile-picker::after {
  border: 0;
}

.disc {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  margin: 0;
  border-radius: 50%;
  background:
    radial-gradient(circle at center, #f6f0e7 0 10rpx, #171512 11rpx 20rpx, transparent 21rpx),
    repeating-radial-gradient(circle at center, #171512 0 4rpx, #2a2825 5rpx 7rpx);
  box-shadow: inset 0 0 0 10rpx #171512, 0 8rpx 16rpx rgba(23,21,18,.12);
}

.disc-label {
  position: absolute;
  left: 30rpx;
  top: 30rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #e8dfd3;
}

.hero-main {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  gap: 22rpx;
  align-items: center;
}

.hero .serif-title {
  margin: 0;
  font-size: 52rpx;
  line-height: 1.08;
}

.hero .muted {
  margin-top: 18rpx;
}

.actions {
  display: grid;
  gap: 14rpx;
  margin-top: 26rpx;
}

.actions button {
  width: 100%;
  margin: 0;
}

.mode-list {
  display: grid;
  gap: 18rpx;
  margin-top: 26rpx;
  width: 100%;
  box-sizing: border-box;
}

.mode-list button {
  width: 100%;
  margin: 0;
}

.mode-card {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  width: 100%;
  min-width: 0;
  justify-self: stretch;
  min-height: 128rpx;
  margin: 0;
  padding: 22rpx 26rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.56);
  text-align: left;
  box-sizing: border-box;
}

.mode-card::after {
  border: 0;
}

.mode-card text {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 31rpx;
  font-weight: 800;
}

.mode-card label {
  display: block;
  margin-top: 8rpx;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  font-weight: 700;
  white-space: normal;
}

.mode-arrow {
  color: inherit;
  font-size: 48rpx;
}

.profile-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(23, 21, 18, .34);
}

.profile-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 42rpx 36rpx 36rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 18rpx;
  background: #fffdfa;
  box-shadow: 0 22rpx 60rpx rgba(23, 21, 18, .18);
}

.profile-modal-title {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.profile-modal-copy {
  margin-top: 12rpx;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
}

.modal-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 116rpx;
  min-width: 116rpx;
  min-height: 116rpx;
  max-width: 116rpx;
  max-height: 116rpx;
  margin: 34rpx auto 28rpx;
  padding: 0;
  box-sizing: border-box;
  line-height: 116rpx;
  color: #fff;
  border-radius: 999rpx;
  background: #171512;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 800;
}

.modal-avatar::after {
  border: 0;
}

.modal-avatar image {
  display: block;
  width: 116rpx;
  height: 116rpx;
  border-radius: 999rpx;
}

.modal-name {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.14);
  border-radius: 12rpx;
  background: rgba(246,240,231,.58);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 700;
}

.modal-confirm {
  width: 100%;
  margin-top: 28rpx;
}

.announcement-popup {
  padding-top: 38rpx;
}

.announcement-popup-content {
  margin-top: 22rpx;
  color: #5f584f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 26rpx;
  line-height: 1.55;
  font-weight: 700;
}

.announcement-popup-content text {
  display: block;
  min-height: 1.55em;
}

.announcement-popup-button {
  margin-top: 28rpx;
}
