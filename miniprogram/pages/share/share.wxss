.share .serif-title {
  margin: 16rpx 0 24rpx;
}

.share-preview {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.52);
}

.share-description text {
  display: inline;
}

.share-emphasis {
  color: #171512;
  font-weight: 900;
  text-decoration: underline;
  text-decoration-thickness: 2rpx;
  text-underline-offset: 5rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  min-width: 76rpx;
  min-height: 76rpx;
  max-width: 76rpx;
  max-height: 76rpx;
  margin: 0 18rpx 0 0;
  padding: 0;
  line-height: 76rpx;
  color: #fff;
  border-radius: 50%;
  background: #171512;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
}

.profile-avatar::after {
  border: 0;
}

.profile-avatar image {
  display: block;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.profile-name {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0;
  border: 0;
  background: transparent;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 700;
}

.cover-stack {
  position: relative;
  flex: 0 0 166rpx;
  height: 118rpx;
  margin-right: 36rpx;
}

.question-stack {
  position: relative;
  flex: 0 0 166rpx;
  height: 118rpx;
  margin-right: 36rpx;
}

.question-stack view {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 90rpx;
  border: 4rpx solid #f6f0e7;
  border-radius: 10rpx;
  color: #171512;
  background: #f4b536;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,.14);
  font-size: 48rpx;
  font-weight: 900;
}

.question-stack view:nth-child(1) {
  left: 0;
  top: 24rpx;
}

.question-stack view:nth-child(2) {
  left: 38rpx;
  top: 12rpx;
}

.question-stack view:nth-child(3) {
  left: 76rpx;
  top: 0;
}

.cover-stack image {
  position: absolute;
  width: 90rpx;
  height: 90rpx;
  border: 4rpx solid #f6f0e7;
  border-radius: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,.14);
}

.cover-stack image:nth-child(1) {
  left: 0;
  top: 24rpx;
}

.cover-stack image:nth-child(2) {
  left: 38rpx;
  top: 12rpx;
}

.cover-stack image:nth-child(3) {
  left: 76rpx;
  top: 0;
}

.share-copy {
  flex: 1;
  min-width: 0;
}

.share-copy view {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 800;
}

.share-copy text {
  display: block;
  margin-top: 8rpx;
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  font-weight: 700;
}

.share-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.share-actions.single {
  grid-template-columns: 1fr;
}

.share-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.share-canvas {
  position: fixed;
  left: -2000px;
  top: -2000px;
  width: 1000px;
  height: 800px;
}

.timeline-canvas {
  position: fixed;
  left: -2000px;
  top: -2000px;
  width: 1000px;
  height: 1000px;
}
