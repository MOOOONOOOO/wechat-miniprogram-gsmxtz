.theme-heart-page {
  padding: 30rpx 36rpx 170rpx;
}

.theme-heart-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 24rpx;
  align-items: end;
  margin: 18rpx 0 28rpx;
}

.theme-heart-head .serif-title {
  margin-bottom: 12rpx;
}

.heart-count {
  font-size: 58rpx;
  line-height: 1;
  font-weight: 900;
}

.heart-count text {
  margin-left: 4rpx;
  color: #827b70;
  font-size: 28rpx;
}

.heart-board {
  position: relative;
  width: 662rpx;
  height: 557rpx;
  margin: 36rpx auto 0;
}

.heart-board.dragging {
  animation: heartBoardLift 180ms ease both;
}

.heart-slot-guide {
  position: absolute;
  box-sizing: border-box;
  border: 4rpx solid rgba(31,122,72,.72);
  border-radius: 0;
  background: rgba(31,122,72,.08);
  box-shadow: 0 0 0 6rpx rgba(31,122,72,.08);
}

.heart-slot {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 4rpx solid #2f2f2f;
  border-radius: 0;
  background: #fffdfa;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,.18);
  overflow: hidden;
  transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
  will-change: transform;
  z-index: 2;
}

.heart-slot.dragging {
  opacity: 1;
  border-color: #1f7a48;
  box-shadow:
    0 0 0 8rpx rgba(31,122,72,.14),
    0 22rpx 38rpx rgba(23,21,18,.26);
  transition: none;
  z-index: 8;
}

.heart-slot.drop-target {
  border-color: #1f7a48;
  box-shadow:
    0 0 0 8rpx rgba(31,122,72,.2),
    0 10rpx 22rpx rgba(31,122,72,.18);
  transform: scale(1.035);
  z-index: 5;
}

.heart-slot.swapping {
  animation: heartSwapPop 240ms ease both;
}

.heart-slot image {
  width: 100%;
  height: 100%;
}

.heart-slot text {
  color: rgba(23,21,18,.34);
  font-size: 54rpx;
  font-weight: 300;
}

.heart-note {
  margin-top: 28rpx;
  color: #5f584f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

@keyframes heartBoardLift {
  from { transform: scale(.992); }
  to { transform: scale(1); }
}

@keyframes heartSwapPop {
  0% { transform: scale(.96); }
  60% { transform: scale(1.045); }
  100% { transform: scale(1); }
}

.theme-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(23,21,18,.08);
  background: rgba(246,240,231,.94);
}

.theme-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
}

.theme-heart-canvas {
  position: fixed;
  left: -2200px;
  top: -2200px;
  width: 750px;
  height: 1240px;
}
