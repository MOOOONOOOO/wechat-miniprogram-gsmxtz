@import "../../styles/tournament-table.wxss";

.tournament-bracket-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.bracket-heading {
  margin-bottom: 24rpx;
}

.bracket-heading .serif-title {
  margin: 10rpx 0 8rpx;
}

.bracket-champion {
  margin-top: 24rpx;
  text-align: center;
}

.bracket-champion view {
  margin-top: 10rpx;
  font-size: 54rpx;
  line-height: 1.15;
  font-weight: 900;
}

.bracket-invalid .muted {
  display: block;
  margin-top: 18rpx;
}
