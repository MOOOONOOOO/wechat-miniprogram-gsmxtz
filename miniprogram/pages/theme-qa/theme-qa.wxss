.qa-select-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.qa-head {
  flex: 0 0 auto;
  margin: 18rpx 0 24rpx;
}

.qa-head .serif-title {
  margin: 8rpx 0 14rpx;
}

.custom-box {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 128rpx;
  gap: 14rpx;
  min-height: 86rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(23,21,18,.13);
  border-radius: 12rpx;
  background: rgba(255,255,255,.62);
}

.custom-box input {
  min-width: 0;
  height: 66rpx;
  padding: 0 14rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 27rpx;
  font-weight: 700;
}

.custom-box button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 66rpx;
  min-height: 66rpx;
  margin: 0;
  padding: 0;
  color: #fffdfa;
  border-radius: 8rpx;
  background: #171512;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
}

.custom-box button::after,
.question-row::after {
  border: 0;
}

.select-meta {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22rpx 0 12rpx;
}

.select-meta view {
  font-size: 34rpx;
  font-weight: 900;
}

.select-meta text {
  color: #827b70;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  font-weight: 900;
}

.question-list {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.question-row {
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr);
  gap: 22rpx;
  align-items: center;
  width: 100%;
  max-width: 100%;
  min-height: 86rpx;
  margin: 0;
  padding: 12rpx 0;
  border-radius: 0;
  background: transparent;
  color: #171512;
  text-align: left;
  line-height: 1.2;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.question-row.selected {
  background: rgba(212,55,45,.06);
}

.question-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  margin: 0;
  border: 3rpx solid #171512;
  box-sizing: border-box;
  background: #fffdfa;
}

.question-row.selected .question-check {
  width: 26rpx;
  height: 26rpx;
  border: 0;
  border-radius: 50%;
  background: #d43a31;
}

.question-check text {
  color: #fff;
  font-size: 17rpx;
  line-height: 1;
  font-weight: 900;
}

.question-copy {
  width: 100%;
  min-width: 0;
}

.question-copy text {
  display: block;
  width: 100%;
  min-width: 0;
  text-align: left;
}

.question-copy text {
  font-size: 29rpx;
  line-height: 1.25;
  font-weight: 900;
}

.sheet-action {
  flex: 0 0 auto;
  margin-top: 18rpx;
}

.sheet-action button {
  width: 100%;
  min-width: 0;
  margin: 0;
}
